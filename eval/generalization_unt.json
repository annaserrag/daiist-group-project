      "title": "UNT sorting quiz",
      "questions": [
        {
          "question_id": 1,
          "question": "In one sentence, what is the main idea implemented by insertion sort?",
          "reference_answer": "Taking one array element at a time, from left to right, it inserts it in the right position among the already sorted elements on its left.",
          "criteria": [
            {
              "id": "iterate",
              "points": 1.0,
              "description": "Describes taking successive individual unsorted items to build an ordered portion."
            },
            {
              "id": "insert",
              "points": 1.0,
              "description": "Places the current item where it belongs relative to previously sorted elements, including equivalent shift or swap explanations."
            }
          ],
          "requires_figure": false
        },
        {
          "question_id": 2,
          "question": "In one sentence, what is the main idea implemented by selection sort?",
          "reference_answer": "Taking one array element at a time, from left to right, it identifies the minimum from the remaining elements and swaps it with the current element.",
          "criteria": [
            {
              "id": "select",
              "points": 1.0,
              "description": "Identifies the extreme remaining value, minimum for ascending order or maximum for descending order."
            },
            {
              "id": "place",
              "points": 1.0,
              "description": "Moves the selected value to the next final position and continues on the remaining values."
            }
          ],
          "requires_figure": false
        }
      ]
    },
    "sources": [
