GEMINI_API_KEY=         # (optional) enables Gemini generation and the public vector builder
GRADE_MODEL=            # (optional) exact Gemini generation model ID; default gemini-3.1-flash-lite
GRADE_INPUT_EUR_PER_M=  # (optional) actual input cost per million tokens in EUR
GRADE_OUTPUT_EUR_PER_M= # (optional) actual output cost per million tokens in EUR
GRADE_INDEX_DESIGN=     # (optional) section or paragraph; default section
GRADE_RETRIEVAL_MODE=   # (optional) auto, lexical or semantic; auto uses the bundled vectors when present
GRADE_EVIDENCE_RANKING= # (optional) multipart or original; original reproduces the first semantic trials
GRADE_PASSAGE_STRATEGY= # (optional) finalize or original; finalize requests a mark or review after the single lookup
GRADE_POLICY_FILE=      # (optional) path to the team's validated Policy JSON, shared with evaluate.py
GRADE_VISION_MODULE=    # (optional) Python module exporting read_exam(path) and VERSION; default vision
GRADE_APPROVED_HASHES=  # (optional) space-separated SHA-256 digests of vetted redacted/synthetic files
HF_TOKEN=               # (optional) write token for the team Space or private log dataset
HF_SPACE=               # (optional) owner/name of team Space
HF_LOG_REPO=            # (optional) private Hugging Face dataset for logs
