# Every variable your app needs, one per line: NAME=   # what it is for
# Copy this file to .env (never committed) and fill it in. On Render, add them in your service's Environment page.
# check.py fails if a variable listed here is not set, unless its line says (optional).

GEMINI_API_KEY=         # (optional) enables Gemini generation and the public vector builder
GRADE_MODEL=            # (optional) exact Gemini generation model ID; default gemini-3.1-flash-lite
GRADE_INPUT_EUR_PER_M=  # (optional) actual input cost per million tokens in EUR
GRADE_OUTPUT_EUR_PER_M= # (optional) actual output cost per million tokens in EUR
GRADE_INDEX_DESIGN=     # (optional) section or paragraph; default section
GRADE_RETRIEVAL_MODE=   # (optional) auto, lexical or semantic; auto uses the bundled vectors when present
GRADE_EVIDENCE_RANKING= # (optional) multipart or original; original reproduces the first semantic trials
GRADE_PASSAGE_STRATEGY= # (optional) finalize or original; finalize requests a mark or review after the single lookup
GRADE_POLICY_FILE=      # (optional) path to the team's validated Policy JSON, shared with evaluate.py
GRADE_VISION_MODULE=    # (optional) Python module exporting read_exam(path) and VERSION; default exam_grader.vision_finetune
GRADE_VISION_ROOT=      # (optional) Local vision-finetune checkout with its own .venv, for exam_grader.vision_finetune
GRADE_APPROVED_HASHES=  # (optional) space-separated SHA-256 digests of vetted redacted/synthetic files
ROBOFLOW_API_KEY=       # (optional) only for downloading detector training data
HF_TOKEN=               # (optional) read token, only if a Hugging Face model download needs one

# Logs database: not needed to run the app. Render sets DATABASE_URL for the online app;
# leave it empty here, so your tests are logged to logs/ and not to the online database.
DATABASE_URL=          # (optional) set by Render, leave empty
LOGS_DATABASE_URL=     # (optional) External Database URL, only for `main.py export-logs`
